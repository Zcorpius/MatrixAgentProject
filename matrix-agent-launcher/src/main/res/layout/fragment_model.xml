<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_accent_dot"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="MODEL GATEWAY" android:textColor="@color/matrix_accent" android:textSize="12sp" android:textStyle="bold"/></LinearLayout>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="serif" android:text="模型与推理" android:textColor="@color/matrix_primary_dark" android:textSize="31sp" android:textStyle="bold"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="云端、局域网和端侧模型统一由 Host 配置与运行。密钥只通过一次性安全通道交给 Host。" android:textColor="@color/matrix_muted" android:textSize="14sp"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="19dp" android:text="运行时" android:textColor="@color/matrix_primary_dark" android:textSize="19sp" android:textStyle="bold"/>
  <TextView android:id="@+id/model_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:background="@drawable/bg_card" android:minHeight="78dp" android:padding="14dp" android:textColor="@color/matrix_text" android:textIsSelectable="true" android:textSize="14sp"/>
  <TextView style="@style/MatrixFieldLabel" android:text="推理来源"/>
  <FrameLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="4dp" android:background="@drawable/bg_card">
   <Spinner android:id="@+id/model_provider" android:layout_width="match_parent" android:layout_height="match_parent" android:popupBackground="@drawable/bg_provider_menu" android:paddingStart="14dp" android:paddingEnd="14dp"/>
  </FrameLayout>
  <TextView android:id="@+id/model_provider_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:textColor="@color/matrix_muted" android:textSize="12sp"/>
  <TextView android:id="@+id/model_id_label" style="@style/MatrixFieldLabel" android:text="模型 ID"/><EditText android:id="@+id/model_id" style="@style/MatrixField" android:hint="可选；留空使用默认模型" android:importantForAutofill="no" android:inputType="text"/>
  <LinearLayout android:id="@+id/model_endpoint_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView style="@style/MatrixFieldLabel" android:text="服务地址"/><EditText android:id="@+id/model_endpoint" style="@style/MatrixField" android:hint="http://127.0.0.1:8000/v1" android:importantForAutofill="no" android:inputType="textUri"/></LinearLayout>
  <LinearLayout android:id="@+id/model_key_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"><TextView android:id="@+id/model_key_label" style="@style/MatrixFieldLabel" android:text="API Key"/><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:background="@drawable/bg_card" android:orientation="horizontal"><EditText android:id="@+id/model_key" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:background="@null" android:hint="仅用于本次安全写入" android:importantForAutofill="no" android:inputType="textPassword" android:minHeight="48dp" android:padding="12dp" android:textColor="@color/matrix_text" android:textSize="15sp"/><ImageButton android:id="@+id/model_key_visibility" android:layout_width="48dp" android:layout_height="48dp" android:layout_gravity="center_vertical" android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="显示或隐藏 API Key" android:src="@drawable/ic_eye_hidden"/></LinearLayout></LinearLayout>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal"><Button android:id="@+id/model_test" style="@style/MatrixOutlineButton" android:layout_width="0dp" android:layout_weight="1" android:text="测试当前配置"/><Button android:id="@+id/model_save" style="@style/MatrixPrimaryButton" android:layout_width="0dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="保存并启用"/></LinearLayout><Button android:id="@+id/model_refresh" style="@style/MatrixOutlineButton" android:layout_width="match_parent" android:layout_marginTop="7dp" android:text="刷新模型状态"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="可用运行时" android:textColor="@color/matrix_primary_dark" android:textSize="19sp" android:textStyle="bold"/><LinearLayout android:id="@+id/model_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:orientation="vertical"/>
 </LinearLayout>
</ScrollView>
