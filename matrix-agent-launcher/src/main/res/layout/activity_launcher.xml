<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:id="@+id/workspace_content"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_paper"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/workspace_header"
            android:layout_width="match_parent"
            android:layout_height="64dp"
            android:background="?attr/matrix_chrome"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="18dp">

            <Button
                android:id="@+id/menu_button"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/launcher_open_navigation"
                android:elevation="0dp"
                android:padding="0dp"
                android:stateListAnimator="@null"
                android:text="@string/launcher_menu"
                android:textAllCaps="false"
                android:textColor="?attr/matrix_chrome_ink"
                android:textSize="26sp" />

            <TextView
                android:id="@+id/page_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:fontFamily="serif"
                android:maxLines="1"
                android:textColor="?attr/matrix_chrome_ink"
                android:textSize="19sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/host_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:maxLines="1"
                android:paddingStart="0dp"
                android:paddingEnd="0dp"
                android:textColor="?attr/matrix_accent"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/matrix_divider" />

        <FrameLayout
            android:id="@+id/page_container"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="@drawable/bg_paper" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/drawer_content"
        android:layout_width="240dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="24dp"
        android:paddingEnd="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="42dp"
                android:layout_height="42dp"
                android:background="@drawable/bg_monogram"
                android:fontFamily="serif"
                android:gravity="center"
                android:text="@string/launcher_monogram"
                android:textColor="?attr/matrix_paper_high"
                android:textSize="20sp"
                android:textStyle="bold" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.16"
                    android:text="@string/launcher_brand"
                    android:textColor="?attr/matrix_accent"
                    android:textSize="10sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="serif"
                    android:text="@string/launcher_product"
                    android:textColor="?attr/matrix_chrome_ink"
                    android:textSize="19sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:lineSpacingExtra="3dp"
            android:text="@string/launcher_drawer_intro"
            android:textColor="?attr/matrix_chrome_muted"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:layout_marginBottom="8dp"
            android:letterSpacing="0.12"
            android:text="@string/launcher_workspace"
            android:textColor="?attr/matrix_ink_faint"
            android:textSize="10sp"
            android:textStyle="bold" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="54dp">
            <Button
                android:id="@+id/nav_conversation"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/bg_nav"
                android:gravity="start|center_vertical"
                android:paddingStart="46dp"
                android:paddingEnd="12dp"
                android:text="@string/nav_conversation"
                android:textAllCaps="false"
                android:textColor="?attr/matrix_chrome_ink"
                android:textSize="15sp"
                android:textStyle="bold" />
            <ImageView android:id="@+id/nav_conversation_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="15dp" android:contentDescription="@null" android:src="@drawable/ic_nav_conversation" app:tint="?attr/matrix_chrome_muted" />
        </FrameLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="3dp">
            <Button android:id="@+id/nav_tasks" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_nav" android:gravity="start|center_vertical" android:paddingStart="46dp" android:paddingEnd="12dp" android:text="@string/nav_tasks" android:textAllCaps="false" android:textColor="?attr/matrix_chrome_ink" android:textSize="15sp" android:textStyle="bold" />
            <ImageView android:id="@+id/nav_tasks_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="15dp" android:contentDescription="@null" android:src="@drawable/ic_nav_tasks" app:tint="?attr/matrix_chrome_muted" />
        </FrameLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="3dp">
            <Button android:id="@+id/nav_voice" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_nav" android:gravity="start|center_vertical" android:paddingStart="46dp" android:paddingEnd="12dp" android:text="@string/nav_voice" android:textAllCaps="false" android:textColor="?attr/matrix_chrome_ink" android:textSize="15sp" android:textStyle="bold" />
            <ImageView android:id="@+id/nav_voice_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="15dp" android:contentDescription="@null" android:src="@drawable/ic_nav_voice" app:tint="?attr/matrix_chrome_muted" />
        </FrameLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="3dp">
            <Button android:id="@+id/nav_models" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_nav" android:gravity="start|center_vertical" android:paddingStart="46dp" android:paddingEnd="12dp" android:text="@string/nav_models" android:textAllCaps="false" android:textColor="?attr/matrix_chrome_ink" android:textSize="15sp" android:textStyle="bold" />
            <ImageView android:id="@+id/nav_models_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="15dp" android:contentDescription="@null" android:src="@drawable/ic_nav_models" app:tint="?attr/matrix_chrome_muted" />
        </FrameLayout>

        <FrameLayout android:layout_width="match_parent" android:layout_height="54dp" android:layout_marginTop="3dp">
            <Button android:id="@+id/nav_downloads" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_nav" android:gravity="start|center_vertical" android:paddingStart="46dp" android:paddingEnd="12dp" android:text="@string/nav_downloads" android:textAllCaps="false" android:textColor="?attr/matrix_chrome_ink" android:textSize="15sp" android:textStyle="bold" />
            <ImageView android:id="@+id/nav_downloads_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="15dp" android:contentDescription="@null" android:src="@drawable/ic_nav_downloads" app:tint="?attr/matrix_chrome_muted" />
        </FrameLayout>

        <Space android:layout_width="1dp" android:layout_height="0dp" android:layout_weight="1" />

        <View android:layout_width="match_parent" android:layout_height="1dp" android:background="?attr/matrix_divider" />

        <FrameLayout android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="8dp">
            <Button android:id="@+id/nav_settings" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_nav" android:gravity="start|center_vertical" android:paddingStart="52dp" android:text="@string/launcher_nav_settings" android:textAllCaps="false" android:textColor="?attr/matrix_chrome_muted" android:textSize="15sp" />
            <ImageView android:id="@+id/nav_settings_icon" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="start|center_vertical" android:layout_marginStart="15dp" android:contentDescription="@null" android:src="@drawable/ic_nav_settings" app:tint="?attr/matrix_chrome_muted" />
        </FrameLayout>

        <TextView
            android:id="@+id/drawer_version"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="4dp"
            android:textColor="?attr/matrix_ink_faint"
            android:textSize="10sp" />
    </LinearLayout>
</androidx.drawerlayout.widget.DrawerLayout>
