<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
  <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_accent_dot"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:text="MODEL VAULT" android:textColor="@color/matrix_accent" android:textSize="12sp" android:textStyle="bold"/></LinearLayout>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fontFamily="serif" android:text="模型库" android:textColor="@color/matrix_primary_dark" android:textSize="31sp" android:textStyle="bold"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:text="在这里浏览端侧模型、查看实时下载，并管理已落盘的本地库。" android:textColor="@color/matrix_muted" android:textSize="14sp"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="19dp" android:orientation="vertical">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal"><View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/bg_accent_dot"/><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:layout_weight="1" android:text="模型市场" android:textColor="@color/matrix_primary_dark" android:textSize="19sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill" android:paddingLeft="9dp" android:paddingTop="4dp" android:paddingRight="9dp" android:paddingBottom="4dp" android:text="MNN MARKET" android:textColor="@color/matrix_primary" android:textSize="10sp" android:textStyle="bold"/></LinearLayout>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="远端目录由 Host 拉取、校验并缓存；下载进度与本地库存会自动同步。" android:textColor="@color/matrix_muted" android:textSize="13sp"/>
   <Button android:id="@+id/download_refresh" style="@style/MatrixOutlineButton" android:layout_width="wrap_content" android:layout_marginTop="11dp" android:text="刷新市场"/>
  </LinearLayout>
  <TextView android:id="@+id/download_notice" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:background="@drawable/bg_notice" android:minHeight="48dp" android:padding="13dp" android:textColor="@color/matrix_text" android:textSize="13sp"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="25dp" android:text="正在传输" android:textColor="@color/matrix_primary_dark" android:textSize="19sp" android:textStyle="bold"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="下载可暂停、继续；进度由 Host 实时投影。" android:textColor="@color/matrix_muted" android:textSize="12sp"/>
  <LinearLayout android:id="@+id/download_active_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical"/>
  <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="25dp" android:text="本地模型库" android:textColor="@color/matrix_primary_dark" android:textSize="19sp" android:textStyle="bold"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="3dp" android:text="已安装模型可在“模型”页选择为端侧运行时。" android:textColor="@color/matrix_muted" android:textSize="12sp"/>
  <LinearLayout android:id="@+id/download_installed_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical"/>
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="25dp" android:gravity="center_vertical" android:orientation="horizontal"><TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="发现模型" android:textColor="@color/matrix_primary_dark" android:textSize="19sp" android:textStyle="bold"/><TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:background="@drawable/bg_pill" android:paddingLeft="9dp" android:paddingTop="4dp" android:paddingRight="9dp" android:paddingBottom="4dp" android:text="远端" android:textColor="@color/matrix_primary_dark" android:textSize="11sp"/></LinearLayout>
  <LinearLayout android:id="@+id/download_catalog_list" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:orientation="vertical"/>
 </LinearLayout>
</ScrollView>
